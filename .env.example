# Salin file ini menjadi .env.local lalu isi nilainya.
# Jangan commit kredensial asli ke repository.

# Supabase (wajib) - dipakai di lib/supabase.ts
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Xendit - payment gateway (wajib untuk produksi)
# Dapatkan di https://dashboard.xendit.co/settings/developers#api-keys (pakai Development key untuk tes)
XENDIT_SECRET_KEY=
# Token verifikasi webhook - set di https://dashboard.xendit.co/settings/developers#callbacks
# lalu isi nilai yang sama di sini; dipakai di app/api/webhooks/xendit
XENDIT_CALLBACK_TOKEN=

# Supabase service role - dipakai server (webhook) untuk update order/langganan bypass RLS
# Dapatkan di Supabase Dashboard > Project Settings > API > service_role key (JANGAN pakai NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# URL publik situs (untuk metadataBase & redirect Xendit), mis. https://rebites.vercel.app
NEXT_PUBLIC_SITE_URL=
